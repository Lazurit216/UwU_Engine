\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{gost-style}[2026/05/19 Lightweight GOST-like report style]

\RequirePackage{fontspec}
\RequirePackage{polyglossia}
\setdefaultlanguage{russian}
\setotherlanguage{english}

\setmainfont{Liberation Serif}
\setsansfont{Liberation Sans}
\setmonofont{Liberation Mono}

\RequirePackage{geometry}
\geometry{
  a4paper,
  left=30mm,
  right=10mm,
  top=20mm,
  bottom=20mm
}

\RequirePackage{setspace}
\onehalfspacing

\RequirePackage{indentfirst}
\setlength{\parindent}{1.25cm}
\setlength{\parskip}{0pt}

\RequirePackage{titlesec}
\titleformat{\section}
  {\normalfont\bfseries\fontsize{14pt}{16pt}\selectfont}
  {\thesection}
  {1em}
  {}
\titleformat{\subsection}
  {\normalfont\bfseries\fontsize{14pt}{16pt}\selectfont}
  {\thesubsection}
  {1em}
  {}
\titleformat{\subsubsection}
  {\normalfont\bfseries\fontsize{14pt}{16pt}\selectfont}
  {\thesubsubsection}
  {1em}
  {}
\titlespacing*{\section}{0pt}{12pt}{6pt}
\titlespacing*{\subsection}{0pt}{12pt}{6pt}
\titlespacing*{\subsubsection}{0pt}{12pt}{6pt}

\RequirePackage{caption}
\DeclareCaptionLabelSeparator{gostdash}{ --- }
\captionsetup{
  labelsep=gostdash,
  justification=centering,
  singlelinecheck=false,
  font=normalsize
}

\RequirePackage{tocloft}
\renewcommand{\cftsecleader}{\cftdotfill{\cftdotsep}}

\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

\RequirePackage{listings}
\RequirePackage{xcolor}
\lstdefinestyle{cppgost}{
  language=C++,
  basicstyle=\ttfamily\small,
  keywordstyle=\bfseries,
  commentstyle=\itshape\color{gray!70!black},
  stringstyle=\color{black},
  numbers=left,
  numberstyle=\tiny,
  stepnumber=1,
  numbersep=8pt,
  breaklines=true,
  breakatwhitespace=false,
  columns=fullflexible,
  keepspaces=true,
  frame=single,
  tabsize=4,
  showstringspaces=false,
  captionpos=b
}
\lstdefinestyle{jsongost}{
  basicstyle=\ttfamily\small,
  numbers=left,
  numberstyle=\tiny,
  stepnumber=1,
  numbersep=8pt,
  breaklines=true,
  breakatwhitespace=false,
  columns=fullflexible,
  keepspaces=true,
  frame=single,
  tabsize=2,
  showstringspaces=false,
  captionpos=b
}

\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage{array}
\RequirePackage{longtable}
\RequirePackage{xurl}
\RequirePackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=black,
  urlcolor=black,
  citecolor=black
}

\DeclareUrlCommand{\codeword}{\urlstyle{tt}}

\newcommand{\placeholderimage}[2]{
  \begin{figure}[H]
    \centering
    \fbox{\begin{minipage}[c][55mm][c]{0.86\textwidth}
      \centering #2
    \end{minipage}}
    \caption{#1}
  \end{figure}
}

\newcommand{\gosttitlepage}[8]{
  \begin{titlepage}
    \begin{center}
      #1\\
      #2\\
      #3

      \vfill

      \textbf{ОТЧЕТ}\\
      по практическому занятию №#4\\
      \textbf{#5}

      \vfill

      \begin{flushright}
        Выполнил: студент группы #6\\
        #7\\[8pt]
        Проверил: #8
      \end{flushright}

      \vfill

      Санкт-Петербург\\
      2026
    \end{center}
  \end{titlepage}
}
